{
  "id": "codex",
  "name": "OpenAI Codex CLI",
  "vendor": "OpenAI",
  "plans": "ChatGPT Plus / Pro / Business",
  "status": "verified",
  "commands": { "win32": ["%APPDATA%\\npm\\codex.cmd", "codex"], "default": ["codex"] },
  "versionArgs": ["--version"],
  "minVersion": "0.164.0",
  "auth": { "type": "command", "args": ["login", "status"], "expect": "Logged in" },
  "usage": { "source": "codex-sessions" },
  "models": "account default (see ~/.codex/config.toml)",
  "run": {
    "read": "codex exec --skip-git-repo-check -s read-only -C \"{cwd}\" \"{prompt}\"",
    "write": "codex exec -s workspace-write -C \"{cwd}\" \"{prompt}\"",
    "review": "codex review --base {base} \"{prompt}\""
  },
  "strengths": "Well-specified fixes from a written plan, writing tests, adversarial review.",
  "install": { "windows": "npm install -g @openai/codex@latest; codex login", "unix": "npm install -g @openai/codex@latest && codex login" },
  "docs": "https://developers.openai.com/codex",
  "notes": "Limits are read from the newest ~/.codex/sessions log, so they are as fresh as the last Codex run. 0.164+ has no mcp-server: call the CLI."
}
